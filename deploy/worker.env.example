# Template for the worker's own environment file (docs/design.md §15.2,
# §15.3). Copy to `.env.worker` at the repository root:
#
#   cp deploy/worker.env.example .env.worker
#
# `.env.worker` matches the `.env.*` pattern in .gitignore, so it is never
# committed. It is a separate file from the compose `.env` on purpose: the
# systemd unit loads it with `EnvironmentFile=`, which (unlike bash) does
# not strip a trailing `# comment` from the end of a value line, so every
# comment here lives on its own line.
#
# Values are otherwise the same ones documented in .env.example and
# docs/runbook.md. Fill in every line below, then point the launchd wrapper
# or the systemd unit's EnvironmentFile at this file.

# Required. Host-published Postgres port (see .env.example's note on the
# container-vs-host distinction).
DATABASE_URL=postgres://orchestra:orchestra@localhost:5432/orchestra

# Optional. Defaults to os.hostname() if unset.
WORKER_HOST=

# Optional. Comma list, e.g. "claude,codex". Defaults to empty (no tags).
WORKER_CAPABILITIES=

# Optional. Default 2.
WORKER_MAX_CONCURRENT=2

# Optional. Default ~/orchestra. A leading ~ is expanded by the worker.
WORKER_WORKSPACE_ROOT=~/orchestra

# Optional. Default 4317. Loopback-only MCP port for agent-tools (design.md §8).
WORKER_TOOLS_PORT=4317

# Optional. Default 85.
WORKER_DISK_HIGH_WATER_PCT=85

# Optional. Default 1200000 (20 minutes).
AGENT_QUIET_TIMEOUT_MS=1200000

# Optional. Default config/pricing.json, resolved against WorkingDirectory
# (the repository checkout root under both units in this directory).
PRICING_FILE=config/pricing.json

# Optional. Used in Jira comment links back to the UI.
PUBLIC_URL=http://localhost:8080

# Optional but required together to enable the Jira poller and write-back
# loop; the worker starts and logs a warning without them (design.md §11.1).
JIRA_BASE_URL=https://goopter.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional but required for the agent to open PRs with `gh`. Exported into
# every agent's environment (design.md §15.3).
GITHUB_TOKEN=

# Optional. Omit to rely on the host's `claude` CLI login instead.
ANTHROPIC_API_KEY=

# Optional. Required for Codex-runtime repositories.
OPENAI_API_KEY=

# Optional. One of fatal, error, warn, info, debug, trace, silent. Default info.
LOG_LEVEL=info
