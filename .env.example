# Copy to .env before `docker compose up` (compose reads .env from the repo
# root automatically). Never commit .env — .gitignore already excludes it.
#
# Container services (migrate, api) always connect to Postgres at db:5432;
# docker-compose.yml builds their DATABASE_URL from POSTGRES_USER/PASSWORD/DB
# below and ignores the DATABASE_URL value in this file. The DATABASE_URL
# below is for the worker running on the host (design.md §15.2) — it reaches
# the same database at localhost:5432 because the db service publishes that
# port to 127.0.0.1 only.

# --- Postgres container credentials, used to build DATABASE_URL for db/migrate/api in docker-compose.yml ---
POSTGRES_USER=orchestra
POSTGRES_PASSWORD=orchestra
POSTGRES_DB=orchestra

# --- design.md §15.3 ---
DATABASE_URL=postgres://orchestra:orchestra@localhost:5432/orchestra # api, worker, migrate. Host worker value shown; containers use db:5432 instead (see note above)
SESSION_SECRET=change-me # api. 32+ bytes; generate with `openssl rand -base64 48`
JIRA_BASE_URL=https://goopter.atlassian.net # worker. Default: https://goopter.atlassian.net
JIRA_EMAIL= # worker. Jira account email for the service token
JIRA_API_TOKEN= # worker. Jira API token for JIRA_EMAIL
GITHUB_TOKEN= # worker, exported to agents. Repo and PR scope
ANTHROPIC_API_KEY= # worker. Or rely on the host's `claude` login
OPENAI_API_KEY= # worker. For Codex
WORKER_HOST= # worker. Default: hostname
WORKER_CAPABILITIES= # worker. Comma list
WORKER_MAX_CONCURRENT=2 # worker. Default 2
WORKER_WORKSPACE_ROOT=~/orchestra # worker. Default ~/orchestra
WORKER_TOOLS_PORT=4317 # worker. Default 4317
WORKER_DISK_HIGH_WATER_PCT=85 # worker. Default 85
AGENT_QUIET_TIMEOUT_MS=1200000 # worker. Default 1200000
PRICING_FILE=config/pricing.json # worker. Default config/pricing.json
PUBLIC_URL=http://localhost:8080 # api, worker. For links in Jira comments

# --- apps/api/src/config.ts extras (read by api and worker, not in the design.md §15.3 table) ---
# `development`/`test` drop the session cookie's Secure flag (apps/api/src/plugins/auth.ts),
# which plain http://localhost use needs. Anything reachable off this machine must stay
# `production` and sit behind TLS (design.md §15.1).
NODE_ENV=production # api. Default production
LOG_LEVEL=info # api, worker. One of fatal, error, warn, info, debug, trace, silent. Default info
